<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Let's Peppol onboarding" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Save your work, then restart your browser. Enable Web eID if prompted. Onboarding will help you install or enable the extension if it is unavailable in the browser you use." />
    <Property Id="WixShellExecTarget" Value="https://be.letspeppol.org/onboarding" />
    <!-- UI only, in the installing user's context. Silent installs and
         maintenance/removal never launch a browser. Restart remains user-driven. -->
    <CustomAction Id="OpenBrowserSetup" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <UI Id="BrowserFinish">
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenBrowserSetup" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND NOT REMOVE" />
    </UI>
  </Fragment>
</Wix>
