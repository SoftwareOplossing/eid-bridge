<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Let's Peppol eID Bridge" Manufacturer="Let's Peppol"
           Version="$(var.Version)" UpgradeCode="b78c4195-034d-40d0-b28c-b0bc36b2d437"
           Language="1033" Scope="perMachine" InstallerVersion="500">
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer Let's Peppol eID Bridge is already installed." />
    <Icon Id="PeppolIcon" SourceFile="$(var.RepoRoot)/install/lets-peppol.ico" />
    <Property Id="ARPPRODUCTICON" Value="PeppolIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://be.letspeppol.org/onboarding" />
    <Property Id="ARPHELPLINK" Value="https://be.letspeppol.org/onboarding" />
    <!-- Match upstream's store installation requests, without force-install policies.
         Preserve an already existing request rather than claiming it on uninstall. -->
    <Property Id="EDGE_EXTENSION_UPDATE" Secure="yes">
      <RegistrySearch Id="EdgeExtensionUpdate" Root="HKLM" Bitness="always32" Type="raw"
                      Key="SOFTWARE\Microsoft\Edge\Extensions\gnmckgbandlkacikdndelhfghdejfido" Name="update_url" />
    </Property>
    <Property Id="CHROME_EXTENSION_UPDATE" Secure="yes">
      <RegistrySearch Id="ChromeExtensionUpdate" Root="HKLM" Bitness="always32" Type="raw"
                      Key="SOFTWARE\Google\Chrome\Extensions\ncibgoaomkmdpilpocfeponihegamlic" Name="update_url" />
    </Property>
    <Property Id="OWN_EDGE_EXTENSION_REQUEST" Secure="yes">
      <RegistrySearch Id="OwnEdgeExtension" Root="HKLM" Bitness="always32" Type="raw"
                      Key="SOFTWARE\LetsPeppol\eID Bridge\ExtensionRequests" Name="Edge" />
    </Property>
    <Property Id="OWN_CHROME_EXTENSION_REQUEST" Secure="yes">
      <RegistrySearch Id="OwnChromeExtension" Root="HKLM" Bitness="always32" Type="raw"
                      Key="SOFTWARE\LetsPeppol\eID Bridge\ExtensionRequests" Name="Chrome" />
    </Property>
    <Launch Condition="NOT EDGE_EXTENSION_UPDATE OR EDGE_EXTENSION_UPDATE = &quot;https://edge.microsoft.com/extensionwebstorebase/v1/crx&quot;"
            Message="The Web eID Edge extension has a different installation source. No extension setting was replaced. Contact support via be.letspeppol.org/onboarding." />
    <Launch Condition="NOT CHROME_EXTENSION_UPDATE OR CHROME_EXTENSION_UPDATE = &quot;https://clients2.google.com/service/update2/crx&quot;"
            Message="The Web eID Chrome extension has a different installation source. No extension setting was replaced. Contact support via be.letspeppol.org/onboarding." />
    <Property Id="OSBUILD" Secure="yes">
      <RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="OSARCH" Secure="yes">
      <RegistrySearch Id="WindowsArchitecture" Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
                      Name="PROCESSOR_ARCHITECTURE" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND OSBUILD &gt;= 22000 AND OSARCH = &quot;AMD64&quot;)"
            Message="Let's Peppol eID Bridge requires Windows 11 on an x64 PC." />
    <Property Id="OWNINSTALLDIR" Secure="yes">
      <RegistrySearch Id="OwnLocation" Root="HKLM" Key="SOFTWARE\LetsPeppol\eID Bridge"
                      Name="InstallDir" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="EXISTING_INSTALL_DIR" Secure="yes">
      <DirectorySearch Id="ExistingFolder" Path="[ProgramFiles64Folder]LetsPeppol eID Bridge" Depth="0" />
    </Property>
    <Launch Condition="NOT EXISTING_INSTALL_DIR OR OWNINSTALLDIR"
            Message="The installation folder already exists and belongs to another installation. Uninstall that application before installing Let's Peppol eID Bridge." />
    <SetProperty Id="EXPECTEDHOST" Value="[OWNINSTALLDIR]eu.webeid.json" After="AppSearch" Sequence="both" />
    <SetProperty Id="EXPECTEDFIREFOXHOST" Value="[OWNINSTALLDIR]eu.webeid.firefox.json" After="SetEXPECTEDHOST" Sequence="both" />
    <Property Id="EXPECTEDHOST" Secure="yes" />
    <Property Id="EXPECTEDFIREFOXHOST" Secure="yes" />
    <SetProperty Id="INSTALLFOLDER" Value="[ProgramFiles64Folder]LetsPeppol eID Bridge" Before="CostFinalize" Sequence="both" />
    <ui:WixUI Id="WixUI_Minimal" />
    <UIRef Id="BrowserFinish" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoRoot)/install/lets-peppol-license.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="LetsPeppol eID Bridge">
        <Component Id="InstallDirectory" Guid="e1d96ecf-31dd-42c4-9624-9710443a488c" Bitness="always64">
          <CreateFolder>
            <PermissionEx Sddl="O:BAG:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
          </CreateFolder>
          <RegistryValue Root="HKLM" Key="SOFTWARE\LetsPeppol\eID Bridge" Name="InstallDir"
                         Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>
        <Component Id="EdgeExtensionRequest" Guid="4a6986af-d853-452d-b9a7-84ac811cced7" Bitness="always32"
                   Condition="NOT EDGE_EXTENSION_UPDATE OR (OWNINSTALLDIR AND OWN_EDGE_EXTENSION_REQUEST)">
          <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Edge\Extensions\gnmckgbandlkacikdndelhfghdejfido"
                         Name="update_url" Type="string" Value="https://edge.microsoft.com/extensionwebstorebase/v1/crx" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\LetsPeppol\eID Bridge\ExtensionRequests"
                         Name="Edge" Type="string" Value="1" />
        </Component>
        <Component Id="ChromeExtensionRequest" Guid="aad866fe-d4c3-45a1-9183-90e09a847ce9" Bitness="always32"
                   Condition="NOT CHROME_EXTENSION_UPDATE OR (OWNINSTALLDIR AND OWN_CHROME_EXTENSION_REQUEST)">
          <RegistryValue Root="HKLM" Key="SOFTWARE\Google\Chrome\Extensions\ncibgoaomkmdpilpocfeponihegamlic"
                         Name="update_url" Type="string" Value="https://clients2.google.com/service/update2/crx" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\LetsPeppol\eID Bridge\ExtensionRequests"
                         Name="Chrome" Type="string" Value="1" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="BridgeMenu" Name="LetsPeppol eID Bridge">
        <Component Id="Shortcuts" Guid="99db3a82-a5ed-4520-a25f-0f5c86086442" Bitness="always64">
          <Shortcut Id="Onboarding" Name="Let's Peppol onboarding" Target="[INSTALLFOLDER]Onboarding.url" />
          <Shortcut Id="Instructions" Name="Installation and support" Target="[INSTALLFOLDER]README.txt" />
          <Shortcut Id="LogFolder" Name="Open Documents for logs" Target="[WindowsFolder]explorer.exe" Arguments="shell:Personal" />
          <RemoveFolder Id="RemoveBridgeMenu" On="uninstall" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\LetsPeppol\eID Bridge" Name="Shortcuts"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Bridge" Title="Let's Peppol eID Bridge" Level="1">
      <ComponentRef Id="InstallDirectory" />
      <ComponentRef Id="EdgeExtensionRequest" />
      <ComponentRef Id="ChromeExtensionRequest" />
      <ComponentRef Id="Shortcuts" />
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentGroupRef Id="NativeHosts" />
    </Feature>
  </Package>
</Wix>
